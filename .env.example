# Canonical production URL for VENTY THE COFFEE
APP_URL="https://ventycoffee.com"

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Path to persistent volume for loyalty database & sessions (defaults to ./data_store)
DATA_STORE_DIR="./data_store"

# Google Maps Platform Place ID for VENTY THE COFFEE (Miliana / Khemis Miliana)
GOOGLE_PLACE_ID="ChIJA4-eLwCThRIROYpgW448oDM"

# Google Places API transient cache TTL in seconds (default: 900 = 15 minutes)
GOOGLE_REVIEWS_CACHE_TTL="900"

# Optional Google Maps API key (leave empty if unconfigured; site functions normally without it)
GOOGLE_MAPS_API_KEY=""

# Secret PIN for Staff POS verification & reward redemption (Required for Staff Portal)
VENTY_STAFF_PIN=""

# High-entropy secret passphrase for Admin Console access (Required for Admin Portal)
VENTY_ADMIN_SECRET=""
